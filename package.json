{
  "name": "zephyr-weather",
  "version": "3.1.0",
  "description": "Zephyr Weather \u2014 temperature and power-fundamentals dashboard for Central Europe",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"tests/**/*.test.js\"",
