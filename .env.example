# Zephyr Weather — environment
# Copy to .env for local development. On Railway, set these as service variables.
# Nothing here is required: with an empty environment the app runs on the
# in-memory cache and skips MET Norway.

# --- Database (optional; it is a CACHE, not the source of truth) -------------
# Railway injects this automatically when a Postgres service is attached.
DATABASE_URL=

# Certificate verification for the Postgres connection. Off by default because
# Railway's public proxy presents a certificate that cannot be chained. Set to 1
# once you are on a verifiable certificate.
PGSSL_STRICT=0

# --- Server ------------------------------------------------------------------
PORT=3000

# --- Upstream ----------------------------------------------------------------
# MET Norway REQUIRE a User-Agent naming your app and a real contact address.
# Without this the cross-check silently loses its only non-Open-Meteo source.
METNO_USER_AGENT=ZephyrWeather/3.0 vit.vavra@zephyrtrade.eu

UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_RETRIES=2
# Hard ceiling on simultaneous requests to one upstream host. Two separate
# rate-limit outages (v1.4.0, v1.4.1) came from unbounded fan-out — do not raise
# this without a reason.
UPSTREAM_MAX_CONCURRENT=6

# --- Behaviour ---------------------------------------------------------------
# How long a cached weather payload stays fresh (it also expires at midnight,
# regardless of this, because the day labels are baked in).
WEATHER_CACHE_MS=3600000

# Write-once history: once a day is 2+ days old its values never change again,
# so a post-trade review sees what the desk saw. Set to 0 to disable.
FREEZE_PAST=1

# Cron for the background refresh, evaluated in Europe/Prague.
REFRESH_CRON=0 */6 * * *

# --- Security ----------------------------------------------------------------
# Minimum gap between manual refreshes (POST /api/fetch).
FETCH_MIN_INTERVAL_MS=60000
# Set to require an x-fetch-token header on POST /api/fetch. Empty = open.
FETCH_TOKEN=
TRUST_PROXY=1

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
# `json` for structured logs (recommended on Railway), `pretty` for a terminal.
LOG_FORMAT=pretty
